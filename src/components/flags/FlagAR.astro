---
interface Props { width?: number | string; height?: number | string; class?: string; }
const { width = 48, height = 32, class: className = '' } = Astro.props;
---
<svg width={width} height={height} class={className} viewBox="0 0 24 16" aria-hidden="true" style="display: block; border-radius: 1.5px; flex-shrink: 0;">
  <rect width="24" height="16" fill="#006C35"></rect>
  <path d="M6,8 h2 v-2 M9,8 h3 v-1 M13,8 h5" stroke="#FFFFFF" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M11,5 v2 M15,5 v2" stroke="#FFFFFF" fill="none" stroke-width="1.2" stroke-linecap="round"></path>
  <circle cx="8" cy="5" r="0.8" fill="#FFFFFF"></circle>
  <path d="M5,12 h12 c0,0 1,-0.5 2,-1.5 v2.5 c-1,-1 -2,-1.5 -2,-1.5 h-12 c-1,0 -2,-0.5 -2,-0.5 s1,1 2,1 z" fill="#FFFFFF"></path>
  <rect x="17" y="10.5" width="1.5" height="3" rx="0.5" fill="#FFFFFF"></rect>
</svg>
